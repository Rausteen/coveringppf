# =============================================================================
# Variables d'environnement — copiez ce fichier en `.env.local` et remplissez.
# Toutes sont OPTIONNELLES : tant qu'une valeur est vide, le script associé
# n'est pas injecté. Ne committez jamais `.env.local`.
# =============================================================================

# --- Domaine canonical (pour les balises canonical / OG / sitemap) ---
# Mettez le domaine final HTTPS quand il est en place.
NEXT_PUBLIC_SITE_URL="https://www.coveringppf-strasbourg.fr"

# --- Tracking : choisissez SOIT GTM (recommandé), SOIT GA4 + Google Ads séparés ---

# Google Tag Manager (recommandé — gère GA4 + Google Ads + Meta depuis l'interface)
NEXT_PUBLIC_GTM_ID=""                        # ex: GTM-XXXXXXX

# Google Analytics 4 (uniquement si vous n'utilisez PAS GTM)
NEXT_PUBLIC_GA4_ID=""                        # ex: G-XXXXXXXXXX

# Google Ads — conversion tracking direct (uniquement si vous n'utilisez PAS GTM)
NEXT_PUBLIC_GOOGLE_ADS_ID=""                 # ex: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""   # ex: abcDEF12ghIJ

# Meta (Facebook / Instagram) Pixel — remarketing
NEXT_PUBLIC_META_PIXEL_ID=""                 # ex: 123456789012345
